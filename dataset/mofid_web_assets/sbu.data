      ##############################
      ##                          ##
      ##  Force Field Definition  ##
      ##                          ##
      ##############################


forcefield              MM2-1991

bondunit                71.94
bond-cubic              -2.0
bond-quartic            1.25       !! keeps Ebond positive; not in "real" MM2
angleunit               0.02191418
angle-sextic            0.00000007
strbndunit              2.51118
mm2-strbnd
opbendunit              0.02191418
torsionunit             0.5
vdwtype                 BUCKINGHAM
radiusrule              ARITHMETIC
radiustype              R-MIN
radiussize              RADIUS
epsilonrule             GEOMETRIC
a-expterm               290000.0
b-expterm               12.5
c-expterm               2.25
vdw-14-scale            1.0
chg-14-scale            1.0
dielectric              1.5



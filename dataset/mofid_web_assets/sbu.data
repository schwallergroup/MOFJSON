#declare Atom_Ge = object { 

                    atom
                    scale Radius_Ge
                    texture {

                     pigment {color Color_Ge}
                     finish {HalfMetalFinish}

                    }
#if (TRANS)
	            interior{ I_Glass}
#end
                   }
